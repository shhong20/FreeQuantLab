[Unit]
Description=FreeQuantLab clean 90d consistent local snapshot and restore verification (not offsite)
Documentation=https://github.com/shhong20/FreeQuantLab
After=freequant-clean-watchdog.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hong/apps/FreeQuantLab-clean-runtime
ExecStart=/home/hong/apps/FreeQuantLab/.venv/bin/python -m quantlab.clean_backup
TimeoutStartSec=180
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/d/FreeQuantLab-Backups
StandardOutput=journal
StandardError=journal
