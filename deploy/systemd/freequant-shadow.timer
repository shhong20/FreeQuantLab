[Unit]
Description=FreeQuantLab daily forward virtual paper checks (Asia/Seoul)
Documentation=https://github.com/shhong20/FreeQuantLab

[Timer]
# WSL host timezone MUST be Asia/Seoul. Crypto UTC candle closes at 09:00 KST.
OnCalendar=*-*-* 09:15:00
OnCalendar=*-*-* 09:25:00
OnCalendar=*-*-* 09:35:00
OnCalendar=*-*-* 10:00:00
AccuracySec=1min
Persistent=true
Unit=freequant-shadow.service

[Install]
WantedBy=timers.target
