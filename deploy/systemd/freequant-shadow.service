[Unit]
Description=FreeQuantLab research-only forward shadow paper cycle
Documentation=https://github.com/shhong20/FreeQuantLab
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hong/apps/FreeQuantLab
ExecStart=/home/hong/apps/FreeQuantLab/.venv/bin/python -m quantlab --config examples/shadow_crypto.json --db state/shadow.db shadow-cycle --protocol protocols/2026-10-20-btc-eth-90d.json
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/hong/apps/FreeQuantLab/state
StandardOutput=journal
StandardError=journal
