[Unit]
Description=FreeQuantLab 90d read-only preopen readiness audit (no paper trades)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hong/apps/FreeQuantLab-observer-runtime
ExecStart=/home/hong/apps/FreeQuantLab/.venv/bin/python -m quantlab.clean_preopen_readiness --db /home/hong/apps/FreeQuantLab/state/clean_shadow_90d.db --protocol /home/hong/apps/FreeQuantLab-clean-runtime/protocols/2026-10-21-btc-eth-clean-90d.json --report-dir /home/hong/apps/FreeQuantLab/state/preopen_readiness
TimeoutStartSec=45
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hong/apps/FreeQuantLab/state/preopen_readiness
StandardOutput=journal
StandardError=journal
