[Unit]
Description=FreeQuantLab weekly 5y public stock price evidence refresh (no trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hong/apps/FreeQuantLab-observer-runtime
ExecStart=/home/hong/apps/FreeQuantLab/.venv/bin/python -m quantlab.stock_long_history --capture --db /home/hong/apps/FreeQuantLab/state/stock_daily/history.sqlite3 --source-db /home/hong/apps/FreeQuantLab/state/stock_daily/observations.sqlite3
ExecStart=/home/hong/apps/FreeQuantLab/.venv/bin/python -m quantlab.stock_long_history --audit --db /home/hong/apps/FreeQuantLab/state/stock_daily/history.sqlite3
TimeoutStartSec=210
Nice=10
IOSchedulingClass=idle
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hong/apps/FreeQuantLab/state/stock_daily
StandardOutput=journal
StandardError=journal
